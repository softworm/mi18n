{
	"name": "mi18n",
	"displayName": "Mi18n",
	"description": "vscode国际化多语言解决方案",
	"author": "王大锤",
	"publisher": "Softworm",
	"version": "1.0.1",
	"engines": {
		"vscode": "^1.59.0"
	},
	"categories": [
		"Extension Packs",
		"Programming Languages",
		"Visualization",
		"Debuggers",
		"Notebooks"
	],
	"keywords": [
		"i18n",
		"i18n Ally",
		"i18n ally",
		"i18n-ally",
		"vue i18n",
		"vue3 i18n",
		"react i18n",
		"多语言",
		"多语言插件",
		"多语言翻译",
		"i18n插件",
		"i18n tool",
		"国际化",
		"国际化多语言",
		"自动翻译",
		"中文",
		"扫描",
		"文案",
		"翻译",
		"翻译插件",
		"中英翻译",
		"i18n vue",
		"vue",
		"vue3",
		"react",
		"react-intl",
		"国际化 i18n",
		"国际化插件"
	],
	"icon": "public/logo.png",
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "extension.mi18n.setting",
				"title": "设置"
			},
			{
				"command": "extension.mi18n.change",
				"title": "语言切换"
			},
			{
				"command": "extension.mi18n.scanAndGenerate",
				"title": "扫描并替换-当前文件"
			},
			{
				"command": "extension.mi18n.multiScanAndGenerate",
				"title": "扫描并替换-全部文件"
			},
			{
				"command": "extension.mi18n.mergeLangFile",
				"title": "合并临时文件"
			},
			{
				"command": "extension.mi18n.splitLangFile",
				"title": "按语言拆分资源"
			},
			{
				"command": "extension.mi18n.translateFromChineseKey",
				"title": "在线翻译"
			},
			{
				"command": "extension.mi18n.missingDetection",
				"title": "翻译漏检"
			},
			{
				"command": "extension.mi18n.updateLocalLangPackage",
				"title": "刷新回显"
			},
			{
				"command": "extension.mi18n.analytics",
				"title": "文件统计"
			},
			{
				"command": "extension.mi18n.receive",
				"title": "自定义命令"
			}
		],
		"menus": {
			"editor/context": [
				{
					"when": "resourceExtname =~ /\\.(ts|js|tsx|jsx|vue|mpx|html|json|yaml|yml)$/",
					"submenu": "mi18n-mainmenu",
					"group": "navigation"
				}
			],
			"mi18n-mainmenu": [
        {
          "command": "extension.mi18n.setting",
          "group": "1_basic@1"
        },
				{
					"command": "extension.mi18n.change",
					"group": "1_basic@2"
				},
				{
					"command": "extension.mi18n.scanAndGenerate",
					"group": "2_main@1"
				},
				{
					"command": "extension.mi18n.multiScanAndGenerate",
					"group": "2_main@2"
				},
				{
					"command": "extension.mi18n.mergeLangFile",
					"group": "2_main@3"
				},
				{
					"command": "extension.mi18n.splitLangFile",
					"group": "2_main@4"
				},
				{
					"command": "extension.mi18n.missingDetection",
					"group": "3_tool@1"
				},
				{
					"command": "extension.mi18n.updateLocalLangPackage",
					"group": "3_tool@2"
				},
				{
					"command": "extension.mi18n.analytics",
					"group": "3_tool@3"
				}
			]
		},
		"submenus": [
			{
				"id": "mi18n-mainmenu",
				"label": "mi18n"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./ && npm run package",
		"package": "webpack --mode production --devtool hidden-source-map",
		"changelog": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0 -n ./changelog-option.js",
		"log": "standard-version --preset gitmoji-config",
		"watch": "npm-run-all -p watch:*",
		"watch:extension": "tsc -watch -p ./",
		"watch:view": "webpack --watch --mode development",
		"pretest": "npm run compile && npm run lint",
		"lint": "eslint src --ext ts",
		"test": "node ./out/test/runTest.js"
	},
	"devDependencies": {
		"@types/glob": "^7.1.4",
		"@types/mocha": "^8.2.2",
		"@types/node": "^16.7.5",
		"@types/prettier": "^2.3.2",
		"@types/react": "^17.0.19",
		"@types/react-dom": "^17.0.9",
		"@types/react-router-dom": "^5.1.8",
		"@types/vscode": "^1.59.0",
		"@typescript-eslint/eslint-plugin": "^4.29.3",
		"@typescript-eslint/parser": "^4.29.3",
		"babel-plugin-import": "^1.13.3",
		"clean-webpack-plugin": "^4.0.0-alpha.0",
		"commitizen": "^4.3.0",
		"css-loader": "^6.2.0",
		"cz-conventional-changelog": "^3.3.0",
		"eslint": "^7.32.0",
		"eslint-plugin-react-hooks": "^4.2.0",
		"glob": "^7.1.7",
		"less-loader": "^10.0.1",
		"mocha": "^8.4.0",
		"npm-run-all": "^4.1.5",
		"rimraf": "^3.0.2",
		"standard-version": "^9.5.0",
		"style-loader": "^3.2.1",
		"terser-webpack-plugin": "^5.1.4",
		"ts-loader": "^9.2.5",
		"typescript": "^4.4.2",
		"vscode-test": "^1.6.1",
		"webpack": "^5.51.1",
		"webpack-cli": "^4.8.0"
	},
	"dependencies": {
		"@ant-design/icons": "^4.6.4",
		"antd": "^4.16.13",
		"conventional-changelog-cli": "^2.2.2",
		"conventional-changelog-gitmoji-config": "^1.4.4",
		"got": "^11.8.2",
		"lodash": "^4.17.21",
		"md5": "^2.3.0",
		"measurement-protocol": "^0.1.1",
		"node-fetch": "^3.0.0",
		"prettier": "^2.3.2",
		"react": "^17.0.2",
		"react-dom": "^17.0.2",
		"uuid": "^9.0.0",
		"yaml": "^1.10.2"
	},
	"config": {
		"commitizen": {
			"path": "./node_modules/cz-conventional-changelog"
		}
	}
}
